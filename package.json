{
  "name": "pokefunny",
  "version": "0.0.0",
  "scripts": {
    "update:pokemon": "node scripts/update-pokemon-catalog.mjs && npm run update:pokemon-images",
    "update:pokemon-images": "node scripts/update-pokemon-images.mjs",
    "update:item-images": "node scripts/update-item-images.mjs",
    "ng": "ng",
    "start": "ng serve",
    "start:server": "tsx server/index.ts",
    "start:multiplayer": "npm run start:server",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "vitest run server"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@lucide/angular": "^1.49.0",
    "@pkmn/dex": "^0.10.11",
    "@vercel/analytics": "^2.0.1",
    "brackets-manager": "1.8.2",
    "brackets-memory-db": "^1.0.6",
    "brackets-model": "^1.7.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "edmonds-blossom-fixed": "^1.0.1",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "csv-parse": "^7.0.3",
    "jsdom": "^27.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
